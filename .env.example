# OWNER_ADMIN_EMAIL: The designated Super Admin email address.
# Only this verified identity receives Super Admin privileges on Telca Marketing.
OWNER_ADMIN_EMAIL="uzairofficials001@gmail.com"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign administrative session JWTs.
JWT_SECRET=""

# ---------------------------------------------------------------------------
# MOBILE WEB PUSH NOTIFICATIONS (VAPID)
# Generate real keys once with: npx web-push generate-vapid-keys
# Never commit or expose VAPID_PRIVATE_KEY in frontend code.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:uzairofficials001@gmail.com"

# ---------------------------------------------------------------------------
# ADMIN EMAIL BACKUP DISPATCH (SMTP / NODEMAILER)
# Configure valid SMTP relay credentials for redundant email notifications.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Telca Marketing Alerts <alerts@telcamarketing.com>"

# ---------------------------------------------------------------------------
# VERIFIED PAYMENT WEBHOOK / CONFIRMATION SECRET
# Required to verify payment provider confirmations before triggering Service Purchase notifications.
# ---------------------------------------------------------------------------
PAYMENT_WEBHOOK_SECRET=""

